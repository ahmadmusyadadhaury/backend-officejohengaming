{
  "info": {
    "name": "Johen Meeting API",
    "description": "API Meeting (read-only) untuk sinkronisasi jadwal meeting. Login untuk mendapat token, lalu gunakan Authorization: Bearer <token>.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login (ambil token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login dengan username & password akun yang sudah ada. Copy nilai 'token' dari respons ke variable 'token' di collection ini."
      }
    },
    {
      "name": "2. Daftar Meetings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/meetings",
          "host": ["{{base_url}}"],
          "path": ["api", "meetings"]
        },
        "description": "Semua meeting + relasi (room, requester, team, teams, assets, participants, mom). Filter opsional via query params: date_from=2026-08-01, date_to=2026-08-31, month=2026-08, status=approved, search=judul, per_page=50."
      }
    },
    {
      "name": "3. Detail Meeting",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/meetings/1",
          "host": ["{{base_url}}"],
          "path": ["api", "meetings", "1"]
        },
        "description": "Detail 1 meeting beserta relasi lengkap. Ganti '1' dengan id meeting."
      }
    },
    {
      "name": "4. Daftar Meetings (dengan filter)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/meetings?month=2026-08&status=approved&per_page=50",
          "host": ["{{base_url}}"],
          "path": ["api", "meetings"],
          "query": [
            {
              "key": "month",
              "value": "2026-08"
            },
            {
              "key": "status",
              "value": "approved"
            },
            {
              "key": "per_page",
              "value": "50"
            }
          ]
        },
        "description": "Contoh penggunaan filter."
      }
    }
  ]
}
